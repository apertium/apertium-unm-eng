<?xml version="1.0" encoding="UTF-8"?>
<modes>

  <!-- unm → eng -->

  <mode name="unm-eng" install="yes" gendebug="yes">
    <pipeline>

      <program name="lt-proc -w">
        <file name="unm-eng.automorf.bin"/>
      </program>


      <program name="cg-proc -w -1 -n">
        <file name="unm-eng.rlx.bin"/>
      </program>
      <program name="lsx-proc">
        <file name="unm-eng.autoseq.bin"/>
      </program>
      <program name="apertium-pretransfer"/>
      <program name="lt-proc -b">
        <file name="unm-eng.autobil.bin"/>
      </program>
      <program name="lrx-proc -m">
        <file name="unm-eng.autolex.bin"/>
      </program>


      <program name="rtx-proc">
        <file name="unm-eng.rtx.bin"/>
      </program>
      <program name="lsx-proc" debug-suff="revautoseq">
        <file name="unm-eng.revautoseq.bin"/>
      </program>

      <program name="lt-proc $1">
        <file name="unm-eng.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="unm-eng.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>

  <!-- eng → unm -->

  <mode name="eng-unm" install="yes" gendebug="yes">
    <pipeline>

      <program name="lt-proc -w">
        <file name="eng-unm.automorf.bin"/>
      </program>


      <program name="cg-proc -w">
        <file name="eng-unm.rlx.bin"/>
      </program>
      <program name="apertium-tagger -g $2">
        <file name="eng-unm.prob"/>
      </program>

      <program name="lsx-proc">
        <file name="eng-unm.autoseq.bin"/>
      </program>
      <program name="apertium-pretransfer"/>
      <program name="lt-proc -b">
        <file name="eng-unm.autobil.bin"/>
      </program>
      <program name="lrx-proc -m">
        <file name="eng-unm.autolex.bin"/>
      </program>


      <program name="rtx-proc">
        <file name="eng-unm.rtx.bin"/>
      </program>
      <program name="lsx-proc" debug-suff="revautoseq">
        <file name="eng-unm.revautoseq.bin"/>
      </program>

      <program name="lt-proc $1">
        <file name="eng-unm.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="eng-unm.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>
</modes>

